{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitw.invalid/schemas/decision-request.schema.json",
  "title": "Decision request (decisions/DR-NNN.md front matter)",
  "x-doc": "docs/11 §4.4",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DR-\\d{3,}$"
    },
    "wp": {
      "type": "string",
      "pattern": "^WP-\\d{3,}$"
    },
    "kind": {
      "enum": [
        "choice",
        "start_approval",
        "scope_change",
        "acceptance_change"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "reversible": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "summary",
          "impact",
          "reversible"
        ],
        "additionalProperties": false
      }
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "option": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "option",
        "reason"
      ],
      "additionalProperties": false
    },
    "needed_by": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^WP-\\d{3,}$"
      }
    },
    "request_sha": {
      "type": "string",
      "minLength": 1
    },
    "resolution": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "APPROVE",
            "REJECT",
            "DEFER",
            null
          ]
        },
        "option": {
          "type": [
            "string",
            "null"
          ]
        },
        "decided_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "dissent": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        }
      },
      "required": [
        "outcome",
        "option",
        "decided_by",
        "decided_at",
        "ref",
        "dissent"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "wp",
    "kind",
    "question",
    "options",
    "recommendation",
    "needed_by",
    "blocks",
    "request_sha",
    "resolution"
  ],
  "additionalProperties": false
}
