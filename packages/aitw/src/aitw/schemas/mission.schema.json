{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitw.invalid/schemas/mission.schema.json",
  "title": "Mission (mission.md front matter)",
  "x-doc": "docs/11 §4.5; kit/templates/mission.md",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^M-\\d{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "backup": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PROPOSED",
        "APPROVED",
        "ACTIVE",
        "COMPLETED",
        "ARCHIVED"
      ]
    },
    "success": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S\\d+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "ladder_required": {
            "enum": [
              "V1",
              "V2",
              "V3",
              "V4",
              "V5"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "ladder_required"
        ],
        "additionalProperties": false
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_only": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_boundaries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_wp": {
          "type": "integer",
          "minimum": 1
        },
        "review_minutes_per_week": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "max_wp",
        "review_minutes_per_week"
      ],
      "additionalProperties": false
    },
    "deadline": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "title",
    "owner",
    "backup",
    "status",
    "success",
    "out_of_scope",
    "human_only",
    "risk_boundaries",
    "budget",
    "deadline"
  ],
  "additionalProperties": false
}
