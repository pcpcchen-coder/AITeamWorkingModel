{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitw.invalid/schemas/takeover-package.schema.json",
  "title": "Takeover package (front matter)",
  "x-doc": "docs/02 §6; kit/templates/takeover-package.md",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TKO-\\d{4}-\\d{2}$"
    },
    "mission": {
      "type": "string",
      "pattern": "^M-\\d{3,}$"
    },
    "for": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "drill",
        "real"
      ]
    },
    "snapshot_sha": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "submitted_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        null
      ]
    }
  },
  "required": [
    "id",
    "mission",
    "for",
    "kind",
    "snapshot_sha",
    "reviewer",
    "started_at",
    "submitted_at",
    "result"
  ],
  "additionalProperties": false
}
