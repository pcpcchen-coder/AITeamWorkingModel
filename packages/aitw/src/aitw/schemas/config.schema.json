{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitw.invalid/schemas/config.schema.json",
  "title": "Project config (.aiteam/config.yaml)",
  "x-doc": "docs/11 §3; kit/templates/config.yaml",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "forge": {
      "enum": [
        "github",
        "gitlab",
        "none"
      ]
    },
    "default_branch": {
      "type": "string",
      "minLength": 1
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "domains": {
            "type": "array",
            "items": {
              "enum": [
                "sw",
                "fw",
                "hw",
                "sys",
                "research"
              ]
            }
          },
          "qualifications": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "handle",
          "roles"
        ],
        "additionalProperties": false
      }
    },
    "agents": {
      "type": "object",
      "properties": {
        "identities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "identities"
      ],
      "additionalProperties": false
    },
    "packs": {
      "type": "array",
      "items": {
        "enum": [
          "sw",
          "fw",
          "hw"
        ]
      }
    },
    "wip": {
      "type": "object",
      "properties": {
        "max_in_review_per_person": {
          "type": "integer",
          "minimum": 1
        },
        "max_open_decisions": {
          "type": "integer",
          "minimum": 1
        },
        "max_rework": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "decision_sla_workdays": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "G0",
          "G1",
          "G2",
          "G3"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "comment_prefix": {
      "type": "string",
      "minLength": 1
    },
    "cadence": {
      "type": "object"
    }
  },
  "required": [
    "project",
    "forge",
    "default_branch",
    "people",
    "agents"
  ],
  "additionalProperties": false
}
