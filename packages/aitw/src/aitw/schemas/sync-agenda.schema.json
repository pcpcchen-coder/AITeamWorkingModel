{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aitw.invalid/schemas/sync-agenda.schema.json",
  "title": "Weekly sync agenda (front matter)",
  "x-doc": "kit/templates/sync-agenda.md",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_from_sha": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "date",
    "attendees",
    "generated_from_sha"
  ],
  "additionalProperties": false
}
